/*
SCFIFO32to4 Decoder_Input_Buffer(
  .clk(clk),      // input wire clk
  .srst(~rst_n),    // input wire srst
  .din(fifo_din),      // input wire [31 : 0] din
  .wr_en(fifo_wr_en),  // input wire wr_en
  .rd_en(fifo_rd_en),  // input wire rd_en
  .dout(fifo_dout),    // output wire [3 : 0] dout
  .full(fifo_full),    // output wire full
  .empty(fifo_empty)  // output wire empty
);
*/
scfifo #(
    .DEPTH(1024),//input 
    .I_WIDTH(32),
    .O_WIDTH(4) //it can be 32 , 16 , 8 , 4 , 2 , 1
) Decoder_Input_Buffer(
    .clk(clk),
    .rst_n(rst_n),
    .wr_en(fifo_wr_en),
    .din(fifo_din),
    .rd_en(fifo_rd_en),
    .empty(fifo_empty),
    .full(fifo_full),
    .dout(fifo_dout),
    .overflow(),
    .underflow(),
    .dout_valid(fifo_dout_valid),
    .fifo_clr(fifo_clr)
);

endmodule
